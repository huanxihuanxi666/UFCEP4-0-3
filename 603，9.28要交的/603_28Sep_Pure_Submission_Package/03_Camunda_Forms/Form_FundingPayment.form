{
  "components": [
    {
      "label": "Patient ID",
      "type": "textfield",
      "id": "Field_patientId",
      "key": "patientId",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Funding type",
      "type": "select",
      "id": "Field_fundingType",
      "key": "fundingType",
      "values": [
        {
          "label": "Hospital funded",
          "value": "HOSPITAL"
        },
        {
          "label": "Authorised exemption",
          "value": "EXEMPTION"
        },
        {
          "label": "Insurer / funding organisation",
          "value": "INSURER"
        },
        {
          "label": "Patient payment",
          "value": "PATIENT"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Funding organisation",
      "type": "textfield",
      "id": "Field_fundingOrganisation",
      "key": "fundingOrganisation",
      "validate": {
        "required": false
      }
    },
    {
      "label": "Authorisation reference",
      "type": "textfield",
      "id": "Field_fundingAuthorisationReference",
      "key": "fundingAuthorisationReference",
      "validate": {
        "required": false
      }
    },
    {
      "label": "Approved amount",
      "type": "textfield",
      "id": "Field_approvedAmount",
      "key": "approvedAmount",
      "validate": {
        "required": false
      }
    },
    {
      "label": "Payment scenario for simulated provider",
      "type": "select",
      "id": "Field_paymentScenario",
      "key": "paymentScenario",
      "values": [
        {
          "label": "Successful",
          "value": "SUCCESSFUL"
        },
        {
          "label": "Declined",
          "value": "DECLINED"
        },
        {
          "label": "Cancelled",
          "value": "CANCELLED"
        },
        {
          "label": "Incomplete",
          "value": "INCOMPLETE"
        },
        {
          "label": "Confirmation lost",
          "value": "CONFIRMATION_LOST"
        },
        {
          "label": "Duplicate risk",
          "value": "DUPLICATE_RISK"
        }
      ],
      "validate": {
        "required": false
      }
    },
    {
      "label": "Urgent treatment override authorised",
      "type": "checkbox",
      "id": "Field_urgentTreatmentOverride",
      "key": "urgentTreatmentOverride"
    }
  ],
  "type": "default",
  "id": "Form_FundingPayment",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.5.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.x"
  },
  "schemaVersion": 16
}