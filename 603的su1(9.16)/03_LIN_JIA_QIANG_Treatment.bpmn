<bpmndi:BPMNEdge id="E_F8_di" bpmnElement="F8"><di:waypoint x="905" y="280"/><di:waypoint x="905" y="240"/><di:waypoint x="725" y="240"/><di:waypoint x="725" y="210"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F9_di" bpmnElement="F9"><di:waypoint x="900" y="168"/><di:waypoint x="950" y="168"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F10_di" bpmnElement="F10"><di:waypoint x="1100" y="168"/><di:waypoint x="1150" y="168"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F11_di" bpmnElement="F11"><di:waypoint x="1340" y="168"/><di:waypoint x="1390" y="168"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F12_di" bpmnElement="F12"><di:waypoint x="1415" y="195"/><di:waypoint x="1415" y="280"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F13_di" bpmnElement="F13"><di:waypoint x="1540" y="320"/><di:waypoint x="1600" y="320"/></bpmndi:BPMNEdge>
