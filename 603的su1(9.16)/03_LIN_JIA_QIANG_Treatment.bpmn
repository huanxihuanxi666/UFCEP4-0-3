<bpmndi:BPMNEdge id="E_F15_di" bpmnElement="F15"><di:waypoint x="1660" y="168"/><di:waypoint x="1710" y="168"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F16_di" bpmnElement="F16"><di:waypoint x="1880" y="168"/><di:waypoint x="1930" y="168"/></bpmndi:BPMNEdge>
