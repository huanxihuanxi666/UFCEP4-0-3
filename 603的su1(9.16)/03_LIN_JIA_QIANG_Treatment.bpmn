<bpmndi:BPMNEdge id="E_F18_di" bpmnElement="F18"><di:waypoint x="2200" y="110"/><di:waypoint x="2270" y="110"/><di:waypoint x="2270" y="170"/><di:waypoint x="2290" y="170"/></bpmndi:BPMNEdge>
