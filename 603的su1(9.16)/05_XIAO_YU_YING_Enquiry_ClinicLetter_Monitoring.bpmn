<bpmndi:BPMNShape id="S_Task_Distribute_di" bpmnElement="Task_Distribute"><dc:Bounds x="1070" y="350" width="170" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_Within7_di" bpmnElement="Gateway_Within7"><dc:Bounds x="1290" y="365" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_WeeklyReminder_di" bpmnElement="Task_WeeklyReminder"><dc:Bounds x="1410" y="350" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_OneMonth_di" bpmnElement="Gateway_OneMonth"><dc:Bounds x="1650" y="365" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_ManagerEscalation_di" bpmnElement="Task_ManagerEscalation"><dc:Bounds x="1770" y="350" width="210" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_ThreeMonths_di" bpmnElement="Gateway_ThreeMonths"><dc:Bounds x="2030" y="365" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_HigherEscalation_di" bpmnElement="Task_HigherEscalation"><dc:Bounds x="2150" y="350" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_End_Letter_di" bpmnElement="End_Letter"><dc:Bounds x="2400" y="372" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="E_F1_di" bpmnElement="F1"><di:waypoint x="86" y="238"/><di:waypoint x="130" y="238"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F2_di" bpmnElement="F2"><di:waypoint x="155" y="213"/><di:waypoint x="155" y="120"/><di:waypoint x="250" y="120"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F3_di" bpmnElement="F3"><di:waypoint x="410" y="120"/><di:waypoint x="460" y="120"/></bpmndi:BPMNEdge>
