<?xml version="1.0" encoding="UTF-8"?>
    <bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
      xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
      xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
      xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
      id="Definitions_1"
      targetNamespace="http://example.com/603/su1">

  <bpmn:process id="Process_XIAO" name="Enquiry, Clinic Letter &amp; Pathway Monitoring" isExecutable="true">
    <bpmn:startEvent id="Start_XIAO" name="Work Item Received"/>
    <bpmn:exclusiveGateway id="Gateway_WorkType" name="Work Type?"/>

    <bpmn:userTask id="Task_RecordEnquiry" name="Record &amp; Classify Enquiry"/>
    <bpmn:exclusiveGateway id="Gateway_EnquiryType" name="Enquiry Type"/>
    <bpmn:userTask id="Task_Admin" name="Handle / Route Administrative Enquiry"/>
    <bpmn:userTask id="Task_Finance" name="Route Financial Enquiry"/>
    <bpmn:userTask id="Task_Clinical" name="Route Clinical Enquiry to Qualified Professional"/>
    <bpmn:endEvent id="End_Enquiry" name="Enquiry Routed / Resolved"/>

    <bpmn:userTask id="Task_DraftLetter" name="Consultant Drafts Clinic Letter"/>
    <bpmn:userTask id="Task_ApproveLetter" name="Consultant Approves Clinical Content"/>
    <bpmn:userTask id="Task_AdminCheck" name="Medical Secretary Administrative Check"/>
    <bpmn:exclusiveGateway id="Gateway_ClinicalError" name="Suspected Clinical Error?"/>
    <bpmn:userTask id="Task_ReturnConsultant" name="Return to Consultant for Correction"/>
    <bpmn:serviceTask id="Task_Distribute" name="Distribute Clinic Letter"/>
    <bpmn:exclusiveGateway id="Gateway_Within7" name="Completed Within 7 Days?"/>
    <bpmn:userTask id="Task_WeeklyReminder" name="Weekly Reminder / Monitor Delay"/>
    <bpmn:exclusiveGateway id="Gateway_OneMonth" name="Outstanding > 1 Month?"/>
    <bpmn:userTask id="Task_ManagerEscalation" name="Escalate to Administrative Manager"/>
    <bpmn:exclusiveGateway id="Gateway_ThreeMonths" name="Outstanding > 3 Months?"/>
    <bpmn:userTask id="Task_HigherEscalation" name="Escalate to Higher Management"/>
    <bpmn:endEvent id="End_Letter" name="Letter Process Complete"/>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_XIAO" targetRef="Gateway_WorkType"/>
    <bpmn:sequenceFlow id="F2" name="Patient Enquiry" sourceRef="Gateway_WorkType" targetRef="Task_RecordEnquiry"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_RecordEnquiry" targetRef="Gateway_EnquiryType"/>
    <bpmn:sequenceFlow id="F4" name="Administrative" sourceRef="Gateway_EnquiryType" targetRef="Task_Admin"/>
    <bpmn:sequenceFlow id="F5" name="Financial" sourceRef="Gateway_EnquiryType" targetRef="Task_Finance"/>
    <bpmn:sequenceFlow id="F6" name="Clinical" sourceRef="Gateway_EnquiryType" targetRef="Task_Clinical"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Admin" targetRef="End_Enquiry"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Finance" targetRef="End_Enquiry"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Clinical" targetRef="End_Enquiry"/>

    <bpmn:sequenceFlow id="F10" name="Clinic Letter" sourceRef="Gateway_WorkType" targetRef="Task_DraftLetter"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_DraftLetter" targetRef="Task_ApproveLetter"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_ApproveLetter" targetRef="Task_AdminCheck"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_AdminCheck" targetRef="Gateway_ClinicalError"/>
    <bpmn:sequenceFlow id="F14" name="Yes" sourceRef="Gateway_ClinicalError" targetRef="Task_ReturnConsultant"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_ReturnConsultant" targetRef="Task_ApproveLetter"/>
    <bpmn:sequenceFlow id="F16" name="No" sourceRef="Gateway_ClinicalError" targetRef="Task_Distribute"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Distribute" targetRef="Gateway_Within7"/>
    <bpmn:sequenceFlow id="F18" name="Yes" sourceRef="Gateway_Within7" targetRef="End_Letter"/>
    <bpmn:sequenceFlow id="F19" name="No" sourceRef="Gateway_Within7" targetRef="Task_WeeklyReminder"/>
    <bpmn:sequenceFlow id="F20" sourceRef="Task_WeeklyReminder" targetRef="Gateway_OneMonth"/>
    <bpmn:sequenceFlow id="F21" name="No" sourceRef="Gateway_OneMonth" targetRef="Task_WeeklyReminder"/>
    <bpmn:sequenceFlow id="F22" name="Yes" sourceRef="Gateway_OneMonth" targetRef="Task_ManagerEscalation"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Task_ManagerEscalation" targetRef="Gateway_ThreeMonths"/>
    <bpmn:sequenceFlow id="F24" name="No" sourceRef="Gateway_ThreeMonths" targetRef="Task_WeeklyReminder"/>
    <bpmn:sequenceFlow id="F25" name="Yes" sourceRef="Gateway_ThreeMonths" targetRef="Task_HigherEscalation"/>
    <bpmn:sequenceFlow id="F26" sourceRef="Task_HigherEscalation" targetRef="End_Letter"/>
  </bpmn:process>

    <bpmndi:BPMNDiagram id="Diagram_XIAO"><bpmndi:BPMNPlane id="Plane_XIAO" bpmnElement="Process_XIAO"><bpmndi:BPMNShape id="S_Start_XIAO_di" bpmnElement="Start_XIAO"><dc:Bounds x="50" y="220" width="36" height="36"/></bpmndi:BPMNShape>
