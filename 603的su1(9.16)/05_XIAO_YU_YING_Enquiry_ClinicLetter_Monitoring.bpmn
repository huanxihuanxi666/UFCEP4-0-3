<bpmndi:BPMNShape id="S_Task_AdminCheck_di" bpmnElement="Task_AdminCheck"><dc:Bounds x="720" y="350" width="200" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_ClinicalError_di" bpmnElement="Gateway_ClinicalError"><dc:Bounds x="970" y="365" width="50" height="50"/></bpmndi:BPMNShape>
