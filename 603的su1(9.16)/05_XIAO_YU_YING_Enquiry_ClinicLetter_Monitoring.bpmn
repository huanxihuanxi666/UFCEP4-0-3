<bpmndi:BPMNShape id="S_End_Enquiry_di" bpmnElement="End_Enquiry"><dc:Bounds x="850" y="112" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_DraftLetter_di" bpmnElement="Task_DraftLetter"><dc:Bounds x="250" y="350" width="180" height="80"/></bpmndi:BPMNShape>
