<?xml version="1.0" encoding="UTF-8"?>
    <bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
      xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
      xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
      xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
      id="Definitions_1"
      targetNamespace="http://example.com/603/su1">

  <bpmn:process id="Process_WUJW" name="Appointment &amp; Patient Communication" isExecutable="true">
    <bpmn:startEvent id="Start_Booking" name="Accepted Referral"/>
    <bpmn:userTask id="Task_ReadRequest" name="Review Booking Request"/>
    <bpmn:serviceTask id="Task_SearchSlot" name="Search External Scheduling Service"/>
    <bpmn:exclusiveGateway id="Gateway_Slot" name="Suitable Slot Available?"/>
    <bpmn:userTask id="Task_ConfirmAppt" name="Confirm Appointment"/>
    <bpmn:serviceTask id="Task_SendLetter" name="Send Appointment Letter"/>
    <bpmn:exclusiveGateway id="Gateway_TwoWeeks" name="Within 2 Weeks?"/>
    <bpmn:userTask id="Task_CallPatient" name="Telephone Patient"/>
    <bpmn:exclusiveGateway id="Gateway_Answered" name="Patient Answered?"/>
    <bpmn:userTask id="Task_RecordSuccess" name="Record Successful Contact"/>
    <bpmn:exclusiveGateway id="Gateway_WantsChange" name="Accepts Appointment?"/>
    <bpmn:userTask id="Task_Reschedule" name="Record Reschedule Request"/>
    <bpmn:userTask id="Task_RecordNoAnswer" name="Record No Answer / Wrong Number"/>
    <bpmn:userTask id="Task_NoSlot" name="Record No Suitable Slot"/>
    <bpmn:exclusiveGateway id="Gateway_Urgent" name="Urgent Referral?"/>
    <bpmn:userTask id="Task_Escalate" name="Escalate to Pathway Team"/>
    <bpmn:userTask id="Task_NormalFollowup" name="Refer for Further Booking Action"/>
    <bpmn:endEvent id="End_Booked" name="Appointment Ready"/>
    <bpmn:endEvent id="End_Escalated" name="Escalated"/>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_Booking" targetRef="Task_ReadRequest"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_ReadRequest" targetRef="Task_SearchSlot"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_SearchSlot" targetRef="Gateway_Slot"/>
    <bpmn:sequenceFlow id="F4" name="Yes" sourceRef="Gateway_Slot" targetRef="Task_ConfirmAppt"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_ConfirmAppt" targetRef="Task_SendLetter"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_SendLetter" targetRef="Gateway_TwoWeeks"/>
    <bpmn:sequenceFlow id="F7" name="No" sourceRef="Gateway_TwoWeeks" targetRef="End_Booked"/>
    <bpmn:sequenceFlow id="F8" name="Yes" sourceRef="Gateway_TwoWeeks" targetRef="Task_CallPatient"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_CallPatient" targetRef="Gateway_Answered"/>
    <bpmn:sequenceFlow id="F10" name="No" sourceRef="Gateway_Answered" targetRef="Task_RecordNoAnswer"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_RecordNoAnswer" targetRef="End_Booked"/>
    <bpmn:sequenceFlow id="F12" name="Yes" sourceRef="Gateway_Answered" targetRef="Gateway_WantsChange"/>
    <bpmn:sequenceFlow id="F13" name="Yes" sourceRef="Gateway_WantsChange" targetRef="Task_RecordSuccess"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_RecordSuccess" targetRef="End_Booked"/>
    <bpmn:sequenceFlow id="F15" name="No - Reschedule" sourceRef="Gateway_WantsChange" targetRef="Task_Reschedule"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Reschedule" targetRef="Task_SearchSlot"/>
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="Gateway_Slot" targetRef="Task_NoSlot"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_NoSlot" targetRef="Gateway_Urgent"/>
    <bpmn:sequenceFlow id="F19" name="Yes" sourceRef="Gateway_Urgent" targetRef="Task_Escalate"/>
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Escalate" targetRef="End_Escalated"/>
    <bpmn:sequenceFlow id="F21" name="No" sourceRef="Gateway_Urgent" targetRef="Task_NormalFollowup"/>
    <bpmn:sequenceFlow id="F22" sourceRef="Task_NormalFollowup" targetRef="End_Escalated"/>
  </bpmn:process>

    <bpmndi:BPMNDiagram id="Diagram_WUJW"><bpmndi:BPMNPlane id="Plane_WUJW" bpmnElement="Process_WUJW"><bpmndi:BPMNShape id="S_Start_Booking_di" bpmnElement="Start_Booking"><dc:Bounds x="60" y="150" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_ReadRequest_di" bpmnElement="Task_ReadRequest"><dc:Bounds x="130" y="130" width="130" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_SearchSlot_di" bpmnElement="Task_SearchSlot"><dc:Bounds x="300" y="130" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_Slot_di" bpmnElement="Gateway_Slot"><dc:Bounds x="500" y="145" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_ConfirmAppt_di" bpmnElement="Task_ConfirmAppt"><dc:Bounds x="600" y="130" width="130" height="80"/></bpmndi:BPMNShape>
