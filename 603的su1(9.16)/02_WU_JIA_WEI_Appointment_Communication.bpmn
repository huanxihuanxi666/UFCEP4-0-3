<bpmndi:BPMNShape id="S_Task_Escalate_di" bpmnElement="Task_Escalate"><dc:Bounds x="810" y="260" width="160" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_NormalFollowup_di" bpmnElement="Task_NormalFollowup"><dc:Bounds x="810" y="380" width="180" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_End_Booked_di" bpmnElement="End_Booked"><dc:Bounds x="1690" y="82" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_End_Escalated_di" bpmnElement="End_Escalated"><dc:Bounds x="1040" y="322" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="E_F1_di" bpmnElement="F1"><di:waypoint x="96" y="168"/><di:waypoint x="130" y="168"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F2_di" bpmnElement="F2"><di:waypoint x="260" y="168"/><di:waypoint x="300" y="168"/></bpmndi:BPMNEdge>
