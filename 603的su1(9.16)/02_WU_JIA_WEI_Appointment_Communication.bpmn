<bpmndi:BPMNShape id="S_Task_CallPatient_di" bpmnElement="Task_CallPatient"><dc:Bounds x="1060" y="130" width="130" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_Answered_di" bpmnElement="Gateway_Answered"><dc:Bounds x="1240" y="145" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_WantsChange_di" bpmnElement="Gateway_WantsChange"><dc:Bounds x="1370" y="145" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_RecordSuccess_di" bpmnElement="Task_RecordSuccess"><dc:Bounds x="1490" y="60" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_Reschedule_di" bpmnElement="Task_Reschedule"><dc:Bounds x="1490" y="200" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_RecordNoAnswer_di" bpmnElement="Task_RecordNoAnswer"><dc:Bounds x="1330" y="300" width="180" height="80"/></bpmndi:BPMNShape>
