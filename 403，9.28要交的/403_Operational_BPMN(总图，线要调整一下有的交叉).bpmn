<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Hospital_Full" targetNamespace="http://example.org/hospital">
  <collaboration id="Collaboration_Hospital">
    <participant id="P_Referrer" name="Referring Organisation"/>
    <participant id="P_Hospital" name="Hospital Patient Administration System" processRef="Process_Hospital"/>
    <participant id="P_Scheduling" name="External Scheduling Service"/>
    <participant id="P_Correspondence" name="External Correspondence Service"/>
    <participant id="P_ClinicalServices" name="External Treatment / Laboratory / Imaging Services"/>
    <participant id="P_Payment" name="External Payment Service Provider"/>
    <messageFlow id="M_Referral" sourceRef="P_Referrer" targetRef="S_Referral" name="Referral"/>
    <messageFlow id="M_MissingReq" sourceRef="T_RequestMissing" targetRef="P_Referrer" name="Request Missing Information"/>
    <messageFlow id="M_MissingInfo" sourceRef="P_Referrer" targetRef="T_ReceiveMissing" name="Additional Information"/>
    <messageFlow id="M_Slot" sourceRef="T_SearchSlot" targetRef="P_Scheduling" name="Scheduling Request"/>
    <messageFlow id="M_ApptLetter" sourceRef="T_SendApptLetter" targetRef="P_Correspondence" name="Appointment Letter"/>
    <messageFlow id="M_Resource" sourceRef="T_CheckResources" targetRef="P_ClinicalServices" name="Resource Availability"/>
    <messageFlow id="M_Payment" sourceRef="T_PaymentRequest" targetRef="P_Payment" name="Payment Request"/>
    <messageFlow id="M_Refund" sourceRef="T_Refund" targetRef="P_Payment" name="Refund Request"/>
    <messageFlow id="M_ClinicLetter" sourceRef="T_DistributeLetter" targetRef="P_Correspondence" name="Clinic Letter"/>
  </collaboration>
  <process id="Process_Hospital" name="Hospital Patient Referral, Treatment and Administration - Integrated" isExecutable="true">
    <laneSet id="LaneSet_Hospital">
      <lane id="L_Secretary" name="Medical Secretary">
        <flowNodeRef>S_Referral</flowNodeRef>
        <flowNodeRef>T_RecordReferral</flowNodeRef>
        <flowNodeRef>T_CheckReferral</flowNodeRef>
        <flowNodeRef>G_InfoComplete</flowNodeRef>
        <flowNodeRef>T_RequestMissing</flowNodeRef>
        <flowNodeRef>T_ReceiveMissing</flowNodeRef>
        <flowNodeRef>T_AdminLetter</flowNodeRef>
        <flowNodeRef>T_DistributeLetter</flowNodeRef>
      </lane>
      <lane id="L_Consultant" name="Consultant / Clinical Team">
        <flowNodeRef>T_ConsultReview</flowNodeRef>
        <flowNodeRef>G_ReferralDecision</flowNodeRef>
        <flowNodeRef>T_AcceptReferral</flowNodeRef>
        <flowNodeRef>T_RejectReferral</flowNodeRef>
        <flowNodeRef>T_RedirectReferral</flowNodeRef>
        <flowNodeRef>T_RequestMoreClinical</flowNodeRef>
        <flowNodeRef>E_Rejected</flowNodeRef>
        <flowNodeRef>E_Redirected</flowNodeRef>
        <flowNodeRef>EV_Attend</flowNodeRef>
        <flowNodeRef>T_Assessment</flowNodeRef>
        <flowNodeRef>G_Consent</flowNodeRef>
        <flowNodeRef>T_Consent</flowNodeRef>
        <flowNodeRef>T_TreatmentRequest</flowNodeRef>
        <flowNodeRef>E_NoTreatment</flowNodeRef>
        <flowNodeRef>T_TreatmentCycle</flowNodeRef>
        <flowNodeRef>G_MoreCycles</flowNodeRef>
        <flowNodeRef>T_BloodReview</flowNodeRef>
        <flowNodeRef>G_Clinical</flowNodeRef>
        <flowNodeRef>T_Delay</flowNodeRef>
        <flowNodeRef>T_Modify</flowNodeRef>
        <flowNodeRef>G_FinImpact</flowNodeRef>
        <flowNodeRef>T_PrepareLetter</flowNodeRef>
        <flowNodeRef>T_ApproveLetter</flowNodeRef>
        <flowNodeRef>T_ClinicalEnquiry</flowNodeRef>
        <flowNodeRef>G_UrgentEnquiry</flowNodeRef>
        <flowNodeRef>T_UrgentClinical</flowNodeRef>
      </lane>
      <lane id="L_Outpatient" name="Outpatient Bookings Team">
        <flowNodeRef>T_BookingRequest</flowNodeRef>
        <flowNodeRef>T_SearchSlot</flowNodeRef>
        <flowNodeRef>G_Slot</flowNodeRef>
        <flowNodeRef>T_NoSlot</flowNodeRef>
        <flowNodeRef>G_UrgentReferral</flowNodeRef>
        <flowNodeRef>T_UrgentCoord</flowNodeRef>
        <flowNodeRef>T_ConfirmAppt</flowNodeRef>
        <flowNodeRef>T_SendApptLetter</flowNodeRef>
        <flowNodeRef>G_TwoWeeks</flowNodeRef>
        <flowNodeRef>T_CallPatient</flowNodeRef>
        <flowNodeRef>G_CallOutcome</flowNodeRef>
        <flowNodeRef>T_ContactOK</flowNodeRef>
        <flowNodeRef>T_NoAnswer</flowNodeRef>
        <flowNodeRef>T_WrongNumber</flowNodeRef>
        <flowNodeRef>T_Reschedule</flowNodeRef>
        <flowNodeRef>G_ApptDone</flowNodeRef>
      </lane>
      <lane id="L_Treatment" name="Treatment &amp; Chemotherapy Bookings Team">
        <flowNodeRef>G_Authorised</flowNodeRef>
        <flowNodeRef>T_ReturnUnauth</flowNodeRef>
        <flowNodeRef>T_CheckResources</flowNodeRef>
        <flowNodeRef>G_Resource</flowNodeRef>
        <flowNodeRef>T_Pending</flowNodeRef>
        <flowNodeRef>T_RetryResource</flowNodeRef>
        <flowNodeRef>T_BookTreatment</flowNodeRef>
      </lane>
      <lane id="L_Finance" name="Finance Team">
        <flowNodeRef>G_Funding</flowNodeRef>
        <flowNodeRef>T_HospitalFunding</flowNodeRef>
        <flowNodeRef>T_InsurerFunding</flowNodeRef>
        <flowNodeRef>T_PaymentRequest</flowNodeRef>
        <flowNodeRef>G_Payment</flowNodeRef>
        <flowNodeRef>T_PaymentOK</flowNodeRef>
        <flowNodeRef>T_PaymentRetry</flowNodeRef>
        <flowNodeRef>T_InvestigatePayment</flowNodeRef>
        <flowNodeRef>G_UrgentPay</flowNodeRef>
        <flowNodeRef>T_PayOverride</flowNodeRef>
        <flowNodeRef>G_FundingReady</flowNodeRef>
        <flowNodeRef>T_FinReview</flowNodeRef>
        <flowNodeRef>G_Refund</flowNodeRef>
        <flowNodeRef>T_Refund</flowNodeRef>
        <flowNodeRef>T_RefundResult</flowNodeRef>
        <flowNodeRef>T_FinEnquiry</flowNodeRef>
      </lane>
      <lane id="L_Admin" name="Call Handling / CNS / Pathway Coordination / Administrative Management">
        <flowNodeRef>G_Letter7</flowNodeRef>
        <flowNodeRef>T_MonitorLetter</flowNodeRef>
        <flowNodeRef>EV_Weekly</flowNodeRef>
        <flowNodeRef>G_LetterAge</flowNodeRef>
        <flowNodeRef>T_Reminder</flowNodeRef>
        <flowNodeRef>T_Manager</flowNodeRef>
        <flowNodeRef>T_Higher</flowNodeRef>
        <flowNodeRef>G_LetterDone</flowNodeRef>
        <flowNodeRef>E_Pathway</flowNodeRef>
        <flowNodeRef>S_Enquiry</flowNodeRef>
        <flowNodeRef>T_RecordEnquiry</flowNodeRef>
        <flowNodeRef>G_Enquiry</flowNodeRef>
        <flowNodeRef>T_AdminEnquiry</flowNodeRef>
        <flowNodeRef>E_Enquiry</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="S_Referral" name="Referral Received"/>
    <userTask id="T_RecordReferral" name="Record Referral &amp; Supporting Documents"/>
    <userTask id="T_CheckReferral" name="Check Supporting Information"/>
    <exclusiveGateway id="G_InfoComplete" name="Supporting Information Complete?"/>
    <sendTask id="T_RequestMissing" name="Request Missing Information"/>
    <receiveTask id="T_ReceiveMissing" name="Receive Missing Information"/>
    <userTask id="T_ConsultReview" name="Consultant Clinical Review"/>
    <exclusiveGateway id="G_ReferralDecision" name="Referral Decision"/>
    <userTask id="T_AcceptReferral" name="Record Acceptance + Booking Requirements"/>
    <userTask id="T_RejectReferral" name="Record Rejection Reason"/>
    <userTask id="T_RedirectReferral" name="Record Redirect &amp; Target Service"/>
    <userTask id="T_RequestMoreClinical" name="Request Further Clinical Information"/>
    <endEvent id="E_Rejected" name="Referral Rejected"/>
    <endEvent id="E_Redirected" name="Referral Redirected"/>
    <sequenceFlow id="F_001" sourceRef="S_Referral" targetRef="T_RecordReferral"/>
    <sequenceFlow id="F_002" sourceRef="T_RecordReferral" targetRef="T_CheckReferral"/>
    <sequenceFlow id="F_003" sourceRef="T_CheckReferral" targetRef="G_InfoComplete"/>
    <sequenceFlow id="F_004" sourceRef="G_InfoComplete" targetRef="T_RequestMissing" name="No"/>
    <sequenceFlow id="F_005" sourceRef="T_RequestMissing" targetRef="T_ReceiveMissing"/>
    <sequenceFlow id="F_006" sourceRef="T_ReceiveMissing" targetRef="T_CheckReferral" name="Re-check"/>
    <sequenceFlow id="F_007" sourceRef="G_InfoComplete" targetRef="T_ConsultReview" name="Yes"/>
    <sequenceFlow id="F_008" sourceRef="T_ConsultReview" targetRef="G_ReferralDecision"/>
    <sequenceFlow id="F_009" sourceRef="G_ReferralDecision" targetRef="T_AcceptReferral" name="Accept"/>
    <sequenceFlow id="F_010" sourceRef="G_ReferralDecision" targetRef="T_RejectReferral" name="Reject"/>
    <sequenceFlow id="F_011" sourceRef="G_ReferralDecision" targetRef="T_RedirectReferral" name="Redirect"/>
    <sequenceFlow id="F_012" sourceRef="G_ReferralDecision" targetRef="T_RequestMoreClinical" name="Further Information"/>
    <sequenceFlow id="F_013" sourceRef="T_RequestMoreClinical" targetRef="T_ReceiveMissing"/>
    <sequenceFlow id="F_014" sourceRef="T_RejectReferral" targetRef="E_Rejected"/>
    <sequenceFlow id="F_015" sourceRef="T_RedirectReferral" targetRef="E_Redirected"/>
    <userTask id="T_BookingRequest" name="Receive Accepted Referral / Booking Request"/>
    <serviceTask id="T_SearchSlot" name="Search External Scheduling Service">
      <extensionElements>
        <zeebe:taskDefinition type="search-appointment-slot" retries="3"/>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="G_Slot" name="Suitable Slot Available?"/>
    <userTask id="T_NoSlot" name="Highlight No Suitable Slot / Refer to Pathway Team"/>
    <exclusiveGateway id="G_UrgentReferral" name="Urgent Referral?"/>
    <userTask id="T_UrgentCoord" name="Urgent Manual Coordination / Escalation"/>
    <userTask id="T_ConfirmAppt" name="Confirm Appointment"/>
    <serviceTask id="T_SendApptLetter" name="Send Appointment Letter">
      <extensionElements>
        <zeebe:taskDefinition type="send-appointment-letter" retries="3"/>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="G_TwoWeeks" name="Appointment Within Two Weeks?"/>
    <userTask id="T_CallPatient" name="Telephone Patient"/>
    <exclusiveGateway id="G_CallOutcome" name="Telephone Outcome"/>
    <userTask id="T_ContactOK" name="Record Successful Contact"/>
    <userTask id="T_NoAnswer" name="Record No Answer"/>
    <userTask id="T_WrongNumber" name="Record Wrong Number"/>
    <userTask id="T_Reschedule" name="Record Reschedule Request"/>
    <exclusiveGateway id="G_ApptDone" name="Appointment Communication Complete"/>
    <intermediateCatchEvent id="EV_Attend" name="Patient Attends New Patient Appointment"/>
    <sequenceFlow id="F_016" sourceRef="T_AcceptReferral" targetRef="T_BookingRequest"/>
    <sequenceFlow id="F_017" sourceRef="T_BookingRequest" targetRef="T_SearchSlot"/>
    <sequenceFlow id="F_018" sourceRef="T_SearchSlot" targetRef="G_Slot"/>
    <sequenceFlow id="F_019" sourceRef="G_Slot" targetRef="T_ConfirmAppt" name="Yes"/>
    <sequenceFlow id="F_020" sourceRef="G_Slot" targetRef="T_NoSlot" name="No"/>
    <sequenceFlow id="F_021" sourceRef="T_NoSlot" targetRef="G_UrgentReferral"/>
    <sequenceFlow id="F_022" sourceRef="G_UrgentReferral" targetRef="T_UrgentCoord" name="Yes"/>
    <sequenceFlow id="F_023" sourceRef="G_UrgentReferral" targetRef="T_SearchSlot" name="No / Retry"/>
    <sequenceFlow id="F_024" sourceRef="T_UrgentCoord" targetRef="T_SearchSlot"/>
    <sequenceFlow id="F_025" sourceRef="T_ConfirmAppt" targetRef="T_SendApptLetter"/>
    <sequenceFlow id="F_026" sourceRef="T_SendApptLetter" targetRef="G_TwoWeeks"/>
    <sequenceFlow id="F_027" sourceRef="G_TwoWeeks" targetRef="T_CallPatient" name="Yes - ALSO telephone"/>
    <sequenceFlow id="F_028" sourceRef="G_TwoWeeks" targetRef="G_ApptDone" name="No"/>
    <sequenceFlow id="F_029" sourceRef="T_CallPatient" targetRef="G_CallOutcome"/>
    <sequenceFlow id="F_030" sourceRef="G_CallOutcome" targetRef="T_ContactOK" name="Answered"/>
    <sequenceFlow id="F_031" sourceRef="G_CallOutcome" targetRef="T_NoAnswer" name="No Answer"/>
    <sequenceFlow id="F_032" sourceRef="G_CallOutcome" targetRef="T_WrongNumber" name="Wrong Number"/>
    <sequenceFlow id="F_033" sourceRef="G_CallOutcome" targetRef="T_Reschedule" name="Reschedule"/>
    <sequenceFlow id="F_034" sourceRef="T_ContactOK" targetRef="G_ApptDone"/>
    <sequenceFlow id="F_035" sourceRef="T_NoAnswer" targetRef="G_ApptDone" name="Attempt Recorded"/>
    <sequenceFlow id="F_036" sourceRef="T_WrongNumber" targetRef="G_ApptDone" name="Issue Recorded"/>
    <sequenceFlow id="F_037" sourceRef="T_Reschedule" targetRef="T_SearchSlot"/>
    <sequenceFlow id="F_038" sourceRef="G_ApptDone" targetRef="EV_Attend"/>
    <userTask id="T_Assessment" name="Assess Patient / Diagnosis / Treatment Options"/>
    <exclusiveGateway id="G_Consent" name="Patient Agrees to Treatment?"/>
    <userTask id="T_Consent" name="Record Patient Consent"/>
    <userTask id="T_TreatmentRequest" name="Create Authorised Treatment Booking Request"/>
    <exclusiveGateway id="G_Authorised" name="Request Complete &amp; Authorised?"/>
    <userTask id="T_ReturnUnauth" name="Return / Reject Unauthorised Request"/>
    <serviceTask id="T_CheckResources" name="Check Treatment / Lab / Imaging Availability">
      <extensionElements>
        <zeebe:taskDefinition type="check-treatment-resource" retries="3"/>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="G_Resource" name="Resources Available?"/>
    <userTask id="T_Pending" name="Keep Pending + Notify Team"/>
    <userTask id="T_RetryResource" name="Record Retry Attempt"/>
    <endEvent id="E_NoTreatment" name="No Treatment / Clinical Pathway Review"/>
    <sequenceFlow id="F_039" sourceRef="EV_Attend" targetRef="T_Assessment"/>
    <sequenceFlow id="F_040" sourceRef="T_Assessment" targetRef="G_Consent"/>
    <sequenceFlow id="F_041" sourceRef="G_Consent" targetRef="T_Consent" name="Yes"/>
    <sequenceFlow id="F_042" sourceRef="G_Consent" targetRef="E_NoTreatment" name="No"/>
    <sequenceFlow id="F_043" sourceRef="T_Consent" targetRef="T_TreatmentRequest"/>
    <sequenceFlow id="F_044" sourceRef="T_TreatmentRequest" targetRef="G_Authorised"/>
    <sequenceFlow id="F_045" sourceRef="G_Authorised" targetRef="T_CheckResources" name="Yes"/>
    <sequenceFlow id="F_046" sourceRef="G_Authorised" targetRef="T_ReturnUnauth" name="No"/>
    <sequenceFlow id="F_047" sourceRef="T_ReturnUnauth" targetRef="T_TreatmentRequest" name="Correct / Re-authorise"/>
    <sequenceFlow id="F_048" sourceRef="T_CheckResources" targetRef="G_Resource"/>
    <sequenceFlow id="F_049" sourceRef="G_Resource" targetRef="T_Pending" name="No"/>
    <sequenceFlow id="F_050" sourceRef="T_Pending" targetRef="T_RetryResource"/>
    <sequenceFlow id="F_051" sourceRef="T_RetryResource" targetRef="T_CheckResources" name="Retry"/>
    <exclusiveGateway id="G_Funding" name="Funding Type"/>
    <userTask id="T_HospitalFunding" name="Record Hospital Funding / Exemption"/>
    <userTask id="T_InsurerFunding" name="Record Funding Organisation, Ref, Amount, Limits"/>
    <serviceTask id="T_PaymentRequest" name="Send Secure Payment Request">
      <extensionElements>
        <zeebe:taskDefinition type="process-payment" retries="3"/>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="G_Payment" name="Payment Status"/>
    <userTask id="T_PaymentOK" name="Record Successful Payment"/>
    <userTask id="T_PaymentRetry" name="Notify Declined / Cancelled / Incomplete; Allow Retry"/>
    <userTask id="T_InvestigatePayment" name="Investigate Confirmation Loss / Possible Duplicate"/>
    <exclusiveGateway id="G_UrgentPay" name="Urgent Treatment Despite Unconfirmed Payment?"/>
    <userTask id="T_PayOverride" name="Record Clinical Override + Refer to Finance"/>
    <exclusiveGateway id="G_FundingReady" name="Funding / Payment Ready"/>
    <userTask id="T_BookTreatment" name="Arrange / Confirm Treatment Appointment"/>
    <sequenceFlow id="F_052" sourceRef="G_Resource" targetRef="G_Funding" name="Yes"/>
    <sequenceFlow id="F_053" sourceRef="G_Funding" targetRef="T_HospitalFunding" name="Hospital Funded / Exemption"/>
    <sequenceFlow id="F_054" sourceRef="G_Funding" targetRef="T_InsurerFunding" name="Insurer / Funding Organisation"/>
    <sequenceFlow id="F_055" sourceRef="G_Funding" targetRef="T_PaymentRequest" name="Patient Payment"/>
    <sequenceFlow id="F_056" sourceRef="T_HospitalFunding" targetRef="G_FundingReady"/>
    <sequenceFlow id="F_057" sourceRef="T_InsurerFunding" targetRef="G_FundingReady"/>
    <sequenceFlow id="F_058" sourceRef="T_PaymentRequest" targetRef="G_Payment"/>
    <sequenceFlow id="F_059" sourceRef="G_Payment" targetRef="T_PaymentOK" name="Successful"/>
    <sequenceFlow id="F_060" sourceRef="G_Payment" targetRef="T_PaymentRetry" name="Declined / Cancelled / Incomplete"/>
    <sequenceFlow id="F_061" sourceRef="G_Payment" targetRef="T_InvestigatePayment" name="Confirmation Lost / Duplicate Risk"/>
    <sequenceFlow id="F_062" sourceRef="T_PaymentOK" targetRef="G_FundingReady"/>
    <sequenceFlow id="F_063" sourceRef="T_PaymentRetry" targetRef="T_PaymentRequest" name="Retry"/>
    <sequenceFlow id="F_064" sourceRef="T_InvestigatePayment" targetRef="G_UrgentPay"/>
    <sequenceFlow id="F_065" sourceRef="G_UrgentPay" targetRef="T_PayOverride" name="Yes"/>
    <sequenceFlow id="F_066" sourceRef="G_UrgentPay" targetRef="T_InvestigatePayment" name="No - Continue Investigation"/>
    <sequenceFlow id="F_067" sourceRef="T_PayOverride" targetRef="G_FundingReady"/>
    <sequenceFlow id="F_068" sourceRef="G_FundingReady" targetRef="T_BookTreatment"/>
    <userTask id="T_TreatmentCycle" name="Deliver Treatment / Chemotherapy Cycle"/>
    <exclusiveGateway id="G_MoreCycles" name="More Treatment Cycles Required?"/>
    <userTask id="T_BloodReview" name="Blood Test + Clinical Review"/>
    <exclusiveGateway id="G_Clinical" name="Clinical Decision"/>
    <userTask id="T_Delay" name="Authorise Treatment Delay"/>
    <userTask id="T_Modify" name="Create Authorised Treatment Modification Request"/>
    <exclusiveGateway id="G_FinImpact" name="Modification Affects Charge / Funding / Payment?"/>
    <userTask id="T_FinReview" name="Review Financial Implications"/>
    <exclusiveGateway id="G_Refund" name="Refund Required?"/>
    <serviceTask id="T_Refund" name="Send Approved Refund Request">
      <extensionElements>
        <zeebe:taskDefinition type="process-refund" retries="3"/>
      </extensionElements>
    </serviceTask>
    <userTask id="T_RefundResult" name="Record Refund Result"/>
    <sequenceFlow id="F_069" sourceRef="T_BookTreatment" targetRef="T_TreatmentCycle"/>
    <sequenceFlow id="F_070" sourceRef="T_TreatmentCycle" targetRef="G_MoreCycles"/>
    <sequenceFlow id="F_071" sourceRef="G_MoreCycles" targetRef="T_BloodReview" name="Yes"/>
    <sequenceFlow id="F_072" sourceRef="T_BloodReview" targetRef="G_Clinical"/>
    <sequenceFlow id="F_073" sourceRef="G_Clinical" targetRef="T_TreatmentCycle" name="Continue"/>
    <sequenceFlow id="F_074" sourceRef="G_Clinical" targetRef="T_Delay" name="Delay"/>
    <sequenceFlow id="F_075" sourceRef="T_Delay" targetRef="T_BloodReview" name="Review Again"/>
    <sequenceFlow id="F_076" sourceRef="G_Clinical" targetRef="T_Modify" name="Modify"/>
    <sequenceFlow id="F_077" sourceRef="T_Modify" targetRef="G_FinImpact"/>
    <sequenceFlow id="F_078" sourceRef="G_FinImpact" targetRef="T_BloodReview" name="No"/>
    <sequenceFlow id="F_079" sourceRef="G_FinImpact" targetRef="T_FinReview" name="Yes"/>
    <sequenceFlow id="F_080" sourceRef="T_FinReview" targetRef="G_Refund"/>
    <sequenceFlow id="F_081" sourceRef="G_Refund" targetRef="T_Refund" name="Yes"/>
    <sequenceFlow id="F_082" sourceRef="G_Refund" targetRef="T_BloodReview" name="No"/>
    <sequenceFlow id="F_083" sourceRef="T_Refund" targetRef="T_RefundResult"/>
    <sequenceFlow id="F_084" sourceRef="T_RefundResult" targetRef="T_BloodReview"/>
    <userTask id="T_PrepareLetter" name="Prepare Clinic Letter"/>
    <userTask id="T_ApproveLetter" name="Approve Clinical Content"/>
    <userTask id="T_AdminLetter" name="Administrative Check + Confirm Recipients"/>
    <serviceTask id="T_DistributeLetter" name="Distribute Clinic Letter">
      <extensionElements>
        <zeebe:taskDefinition type="send-clinic-letter" retries="3"/>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="G_Letter7" name="Completed / Sent Within 7 Days?"/>
    <userTask id="T_MonitorLetter" name="Add Delayed Letter to Pathway Monitoring"/>
    <intermediateCatchEvent id="EV_Weekly" name="Weekly Reminder Timer">
      <timerEventDefinition>
        <timeCycle>R/P7D</timeCycle>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <exclusiveGateway id="G_LetterAge" name="Outstanding Duration"/>
    <userTask id="T_Reminder" name="Send Weekly Reminder to Consultant"/>
    <userTask id="T_Manager" name="Escalate to Administrative Manager (&gt;1 month)"/>
    <userTask id="T_Higher" name="Escalate to Higher Management (&gt;3 months)"/>
    <exclusiveGateway id="G_LetterDone" name="Clinic Letter Completed?"/>
    <endEvent id="E_Pathway" name="Patient Pathway Complete"/>
    <sequenceFlow id="F_085" sourceRef="G_MoreCycles" targetRef="T_PrepareLetter" name="No"/>
    <sequenceFlow id="F_086" sourceRef="T_PrepareLetter" targetRef="T_ApproveLetter"/>
    <sequenceFlow id="F_087" sourceRef="T_ApproveLetter" targetRef="T_AdminLetter"/>
    <sequenceFlow id="F_088" sourceRef="T_AdminLetter" targetRef="T_DistributeLetter"/>
    <sequenceFlow id="F_089" sourceRef="T_DistributeLetter" targetRef="G_Letter7"/>
    <sequenceFlow id="F_090" sourceRef="G_Letter7" targetRef="E_Pathway" name="Yes"/>
    <sequenceFlow id="F_091" sourceRef="G_Letter7" targetRef="T_MonitorLetter" name="No"/>
    <sequenceFlow id="F_092" sourceRef="T_MonitorLetter" targetRef="EV_Weekly"/>
    <sequenceFlow id="F_093" sourceRef="EV_Weekly" targetRef="G_LetterAge"/>
    <sequenceFlow id="F_094" sourceRef="G_LetterAge" targetRef="T_Reminder" name="7 days - 1 month"/>
    <sequenceFlow id="F_095" sourceRef="G_LetterAge" targetRef="T_Manager" name="&gt;1 month"/>
    <sequenceFlow id="F_096" sourceRef="G_LetterAge" targetRef="T_Higher" name="&gt;3 months"/>
    <sequenceFlow id="F_097" sourceRef="T_Reminder" targetRef="G_LetterDone"/>
    <sequenceFlow id="F_098" sourceRef="T_Manager" targetRef="G_LetterDone"/>
    <sequenceFlow id="F_099" sourceRef="T_Higher" targetRef="G_LetterDone"/>
    <sequenceFlow id="F_100" sourceRef="G_LetterDone" targetRef="E_Pathway" name="Yes - Stop reminders"/>
    <sequenceFlow id="F_101" sourceRef="G_LetterDone" targetRef="EV_Weekly" name="No"/>
    <startEvent id="S_Enquiry" name="Patient Enquiry Received"/>
    <userTask id="T_RecordEnquiry" name="Record, Classify Priority &amp; Assign Team"/>
    <exclusiveGateway id="G_Enquiry" name="Enquiry Type"/>
    <userTask id="T_AdminEnquiry" name="Answer / Route Administrative Enquiry"/>
    <userTask id="T_FinEnquiry" name="Route Financial Enquiry to Finance"/>
    <userTask id="T_ClinicalEnquiry" name="Route Clinical Enquiry to CNS / Authorised Clinician"/>
    <exclusiveGateway id="G_UrgentEnquiry" name="Urgent Clinical Concern?"/>
    <userTask id="T_UrgentClinical" name="Highlight Immediately / Clinical Escalation"/>
    <endEvent id="E_Enquiry" name="Enquiry Resolved"/>
    <sequenceFlow id="F_102" sourceRef="S_Enquiry" targetRef="T_RecordEnquiry"/>
    <sequenceFlow id="F_103" sourceRef="T_RecordEnquiry" targetRef="G_Enquiry"/>
    <sequenceFlow id="F_104" sourceRef="G_Enquiry" targetRef="T_AdminEnquiry" name="Administrative"/>
    <sequenceFlow id="F_105" sourceRef="G_Enquiry" targetRef="T_FinEnquiry" name="Financial"/>
    <sequenceFlow id="F_106" sourceRef="G_Enquiry" targetRef="T_ClinicalEnquiry" name="Clinical"/>
    <sequenceFlow id="F_107" sourceRef="T_AdminEnquiry" targetRef="E_Enquiry"/>
    <sequenceFlow id="F_108" sourceRef="T_FinEnquiry" targetRef="E_Enquiry"/>
