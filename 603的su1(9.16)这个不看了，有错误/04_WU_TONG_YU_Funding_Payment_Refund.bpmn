<bpmndi:BPMNEdge id="E_F15_di" bpmnElement="F15"><di:waypoint x="1060" y="330"/><di:waypoint x="1090" y="330"/><di:waypoint x="1090" y="198"/><di:waypoint x="1120" y="198"/></bpmndi:BPMNEdge>
