<bpmndi:BPMNEdge id="E_F6_di" bpmnElement="F6"><di:waypoint x="590" y="100"/><di:waypoint x="1090" y="100"/><di:waypoint x="1090" y="198"/><di:waypoint x="1120" y="198"/></bpmndi:BPMNEdge>
