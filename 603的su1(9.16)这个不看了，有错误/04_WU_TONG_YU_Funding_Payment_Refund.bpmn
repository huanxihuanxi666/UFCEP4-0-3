<?xml version="1.0" encoding="UTF-8"?>
    <bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
      xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
      xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
      xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
      id="Definitions_1"
      targetNamespace="http://example.com/603/su1">

  <bpmn:process id="Process_WUTY" name="Funding, Payment &amp; Refund" isExecutable="true">
    <bpmn:startEvent id="Start_Finance" name="Treatment Requires Funding Check"/>
    <bpmn:userTask id="Task_CheckFunding" name="Review Funding Status"/>
    <bpmn:exclusiveGateway id="Gateway_Funding" name="Funding Source"/>
    <bpmn:userTask id="Task_Hospital" name="Record Hospital Funding"/>
    <bpmn:userTask id="Task_Insurer" name="Record Approved Funding Organisation"/>
    <bpmn:serviceTask id="Task_Payment" name="Process Patient Payment"/>
    <bpmn:exclusiveGateway id="Gateway_Confirmation" name="Confirmation Received?"/>
    <bpmn:exclusiveGateway id="Gateway_PaymentResult" name="Payment Successful?"/>
    <bpmn:userTask id="Task_RecordPaid" name="Record Payment"/>
    <bpmn:userTask id="Task_Failed" name="Record Declined / Incomplete Payment"/>
    <bpmn:userTask id="Task_Investigate" name="Investigate Possible Completed Payment"/>
    <bpmn:exclusiveGateway id="Gateway_FinancialOK" name="Financial Condition Satisfied?"/>
    <bpmn:userTask id="Task_AllowBooking" name="Allow Treatment Booking Confirmation"/>
    <bpmn:userTask id="Task_KeepPending" name="Keep Treatment Booking Pending"/>
    <bpmn:exclusiveGateway id="Gateway_RefundNeeded" name="Refund Required?"/>
    <bpmn:userTask id="Task_ReviewRefund" name="Review Refund Eligibility"/>
    <bpmn:serviceTask id="Task_Refund" name="Process Refund"/>
    <bpmn:endEvent id="End_Finance" name="Finance Process Complete"/>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_Finance" targetRef="Task_CheckFunding"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CheckFunding" targetRef="Gateway_Funding"/>
    <bpmn:sequenceFlow id="F3" name="Hospital" sourceRef="Gateway_Funding" targetRef="Task_Hospital"/>
    <bpmn:sequenceFlow id="F4" name="Approved Organisation" sourceRef="Gateway_Funding" targetRef="Task_Insurer"/>
    <bpmn:sequenceFlow id="F5" name="Patient Payment" sourceRef="Gateway_Funding" targetRef="Task_Payment"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Hospital" targetRef="Gateway_FinancialOK"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Insurer" targetRef="Gateway_FinancialOK"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Payment" targetRef="Gateway_Confirmation"/>
    <bpmn:sequenceFlow id="F9" name="No" sourceRef="Gateway_Confirmation" targetRef="Task_Investigate"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Investigate" targetRef="Gateway_FinancialOK"/>
    <bpmn:sequenceFlow id="F11" name="Yes" sourceRef="Gateway_Confirmation" targetRef="Gateway_PaymentResult"/>
    <bpmn:sequenceFlow id="F12" name="Yes" sourceRef="Gateway_PaymentResult" targetRef="Task_RecordPaid"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_RecordPaid" targetRef="Gateway_FinancialOK"/>
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="Gateway_PaymentResult" targetRef="Task_Failed"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Failed" targetRef="Gateway_FinancialOK"/>
    <bpmn:sequenceFlow id="F16" name="Yes" sourceRef="Gateway_FinancialOK" targetRef="Task_AllowBooking"/>
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="Gateway_FinancialOK" targetRef="Task_KeepPending"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_AllowBooking" targetRef="Gateway_RefundNeeded"/>
    <bpmn:sequenceFlow id="F19" sourceRef="Task_KeepPending" targetRef="End_Finance"/>
    <bpmn:sequenceFlow id="F20" name="No" sourceRef="Gateway_RefundNeeded" targetRef="End_Finance"/>
    <bpmn:sequenceFlow id="F21" name="Yes" sourceRef="Gateway_RefundNeeded" targetRef="Task_ReviewRefund"/>
    <bpmn:sequenceFlow id="F22" sourceRef="Task_ReviewRefund" targetRef="Task_Refund"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Task_Refund" targetRef="End_Finance"/>
  </bpmn:process>

    <bpmndi:BPMNDiagram id="Diagram_WUTY"><bpmndi:BPMNPlane id="Plane_WUTY" bpmnElement="Process_WUTY"><bpmndi:BPMNShape id="S_Start_Finance_di" bpmnElement="Start_Finance"><dc:Bounds x="50" y="180" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_CheckFunding_di" bpmnElement="Task_CheckFunding"><dc:Bounds x="120" y="160" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_Funding_di" bpmnElement="Gateway_Funding"><dc:Bounds x="320" y="175" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_Hospital_di" bpmnElement="Task_Hospital"><dc:Bounds x="430" y="60" width="160" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_Insurer_di" bpmnElement="Task_Insurer"><dc:Bounds x="430" y="160" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_Payment_di" bpmnElement="Task_Payment"><dc:Bounds x="430" y="280" width="160" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_Confirmation_di" bpmnElement="Gateway_Confirmation"><dc:Bounds x="650" y="295" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_Investigate_di" bpmnElement="Task_Investigate"><dc:Bounds x="760" y="360" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_PaymentResult_di" bpmnElement="Gateway_PaymentResult"><dc:Bounds x="760" y="250" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_RecordPaid_di" bpmnElement="Task_RecordPaid"><dc:Bounds x="870" y="180" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_Failed_di" bpmnElement="Task_Failed"><dc:Bounds x="870" y="290" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_FinancialOK_di" bpmnElement="Gateway_FinancialOK"><dc:Bounds x="1120" y="175" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_AllowBooking_di" bpmnElement="Task_AllowBooking"><dc:Bounds x="1230" y="100" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_KeepPending_di" bpmnElement="Task_KeepPending"><dc:Bounds x="1230" y="240" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Gateway_RefundNeeded_di" bpmnElement="Gateway_RefundNeeded"><dc:Bounds x="1480" y="115" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_ReviewRefund_di" bpmnElement="Task_ReviewRefund"><dc:Bounds x="1590" y="80" width="170" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_Task_Refund_di" bpmnElement="Task_Refund"><dc:Bounds x="1810" y="80" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_End_Finance_di" bpmnElement="End_Finance"><dc:Bounds x="2030" y="172" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="E_F1_di" bpmnElement="F1"><di:waypoint x="86" y="198"/><di:waypoint x="120" y="198"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F2_di" bpmnElement="F2"><di:waypoint x="270" y="198"/><di:waypoint x="320" y="198"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F3_di" bpmnElement="F3"><di:waypoint x="345" y="175"/><di:waypoint x="345" y="100"/><di:waypoint x="430" y="100"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="E_F4_di" bpmnElement="F4"><di:waypoint x="370" y="198"/><di:waypoint x="430" y="198"/></bpmndi:BPMNEdge>
