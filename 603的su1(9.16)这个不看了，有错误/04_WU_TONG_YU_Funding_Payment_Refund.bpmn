<bpmndi:BPMNEdge id="E_F10_di" bpmnElement="F10"><di:waypoint x="950" y="400"/><di:waypoint x="1090" y="400"/><di:waypoint x="1090" y="198"/><di:waypoint x="1120" y="198"/></bpmndi:BPMNEdge>
